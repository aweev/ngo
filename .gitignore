# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# PWA build artifacts (generated by @ducanh2912/next-pwa)
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/swe-worker-*.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# Every .env* variant is ignored by default: `.env.production` /
# `.env.staging` hold real secrets and must never be committable.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local package store (pnpm store kept inside the workspace)
.pnpm-store/

# logs & diagnostics (regenerable; never commit)
*.log
*-diag.txt
validation-summary.txt

# test artifacts (regenerable)
/playwright-report/
/test-results/

# supabase CLI link state (contains project refs / pooler URLs)
supabase/.temp/

# one-shot codemods already applied (kept locally, out of the tree's way)
scripts/codemods/
