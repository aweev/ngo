# =====================================================
# NGO OS - Environment Configuration
# =====================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================================
# Supabase Configuration
# =====================================================
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api

# Public Supabase URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon Key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (NEVER expose to browser - server only)
# This key bypasses Row Level Security - use with caution!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Metrics endpoint (/api/metrics) — Prometheus/text health, reliability and UX
# metrics for the incidents runbook. 404 when unset; use a long random token.
METRICS_TOKEN=

# =====================================================
# CMS AI Translation (optional - enables the AI button)
# =====================================================
# Supported providers: openai, deepl, google
CMS_TRANSLATION_PROVIDER=openai
CMS_TRANSLATION_API_KEY=sk-...
# Optional overrides:
# CMS_TRANSLATION_API_URL=https://api.openai.com/v1/chat/completions
# CMS_TRANSLATION_MODEL=gpt-4o-mini
# DeepL:
# DEEPL_API_KEY=dlc-...
# Google:
# GOOGLE_TRANSLATION_API_KEY=AIza...

# =====================================================
# Payments (optional - Stripe Checkout)
# =====================================================
# When unset, donations are recorded as explicit "pledges".
# When set, donations complete through Stripe Checkout.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# =====================================================
# Email delivery (Resend — required for donation receipts)
# =====================================================
# Get a key at https://resend.com/api-keys, verify your sending domain,
# then set EMAIL_FROM to an address on that domain.
RESEND_API_KEY=re_...
EMAIL_FROM=spenden@awe-ev.org
# Internal notifications (CMS review requests).
ADMIN_EMAIL=team@awe-ev.org

# =====================================================
# Signed receipt links (required in production)
# =====================================================
# 32+ char random secret signing /api/receipts + /api/tax-receipts tokens.
# Generate: openssl rand -hex 32
RECEIPT_HMAC_SECRET=change-me-to-32-plus-random-chars-minimum

# =====================================================
# Node Environment
# =====================================================
NODE_ENV=development

# =====================================================
# Rate limiting & abuse prevention (audit Wave 0, item 3)
# =====================================================
# Primary limiter is the distributed Postgres counter
# (consume_rate_limit, migration 20260922000003) and needs
# SUPABASE_SERVICE_ROLE_KEY. Set memory_only to skip it (dev only).
# RATE_LIMIT_MODE=memory_only
# Number of trusted proxy hops in front of the app. ONLY with this set is
# x-forwarded-for honored (rightmost N entries). Keep 0 if in doubt.
TRUSTED_PROXY_HOPS=0
# Opt-in: honor x-real-ip when there are no trusted proxies (edge sets it).
# TRUST_PROXY_REAL_IP=false
# CAPTCHA: Cloudflare Turnstile and/or hCaptcha (server-side verification).
# TURNSTILE_SECRET_KEY=
# HCAPTCHA_SECRET_KEY=
# 'required' rejects public submissions without a CAPTCHA token.
# PUBLIC_CAPTCHA_MODE=required
# Edge gate ("apply CDN/WAF limits first"): the CDN/WAF must echo this secret
# in x-awe-edge-secret. When set, a request that reached the origin directly
# (bypassing the edge) is refused before any database work.
# EDGE_SHARED_SECRET=
# Abuse alerting: ops webhook (Slack/Teams) that receives risk-scored, PII-free
# alerts, and the risk score (0-100) at which they are sent. Default 50.
# ABUSE_ALERT_WEBHOOK_URL=
# ABUSE_ALERT_MIN_SCORE=50
# Salt for hashing throttle identities (IP/email) before they are stored or
# shipped to alerting. REQUIRED in production — the service-role key is no
# longer used as a fallback. Generate: openssl rand -hex 32
# ABUSE_HASH_SALT=

# =====================================================
# Field PII encryption (Phase 1 — beneficiary names/phones)
# =====================================================
# REQUIRED in production: without it the registration flow refuses to store
# PII (fail closed). 32+ chars. Generate: openssl rand -hex 32
# ENCRYPTION_KEY=
# Twilio WhatsApp field-report webhook (audit Wave 0, item 2).
# TWILIO_WEBHOOK_URL=https://your-app.example.org/api/webhooks/whatsapp
# TWILIO_AUTH_TOKEN=
# Dev only: accept unsigned webhook traffic outside production.
# TWILIO_ALLOW_UNSIGNED_WEBHOOK=true

# =====================================================
# Phase 0 bloat freeze (item 0.3.1)
# =====================================================
# When true, the admin sidebar + command palette show ALL sections,
# including ones hidden by the Phase 0 freeze. Use only while exporting
# data out of a hidden module. Default (unset/false): frozen nav.
# NEXT_PUBLIC_PHASE0_FULL_NAV=false

# =====================================================
# Truthful AI assistance (audit Wave 0, item 4)
# =====================================================
# The copilot is disabled by default and NEVER simulates output.
# Set true only when a real provider integration exists.
# AI_COPILOT_ENABLED=false

# =====================================================
# Observability (optional - wire before prod)
# =====================================================
# Client + server DSNs from https://sentry.io (CSP already allows *.sentry.io).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Uptime: monitor GET / (200) and POST /api/stripe/webhook without
# signature (expected 400 = route live).
