# =====================================================
# NGO OS - Environment Configuration
# =====================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================================
# Supabase Configuration
# =====================================================
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api

# Public Supabase URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon Key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (NEVER expose to browser - server only)
# This key bypasses Row Level Security - use with caution!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =====================================================
# CMS AI Translation (optional - enables the AI button)
# =====================================================
# Supported providers: openai
CMS_TRANSLATION_PROVIDER=openai
CMS_TRANSLATION_API_KEY=sk-...
# Optional overrides:
# CMS_TRANSLATION_API_URL=https://api.openai.com/v1/chat/completions
# CMS_TRANSLATION_MODEL=gpt-4o-mini

# =====================================================
# Payments (optional - Stripe Checkout)
# =====================================================
# When unset, donations are recorded as explicit "pledges".
# When set, donations complete through Stripe Checkout.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# =====================================================
# Node Environment
# =====================================================
NODE_ENV=development

# =====================================================
# Observability (optional - wire before prod)
# =====================================================
# Client + server DSNs from https://sentry.io (CSP already allows *.sentry.io).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Uptime: monitor GET / (200) and POST /api/stripe/webhook without
# signature (expected 400 = route live).
